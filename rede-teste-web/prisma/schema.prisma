  anexos             JurisAnexo[]
  referenciasLei     JurisReferenciaLei[]
  referenciasJuris   JurisReferenciaJuris[] @relation("JurisRefFrom")
  referenciasPara    JurisReferenciaJuris[] @relation("JurisRefTo")
  publicacoes        JurisPublicacaoDiario[]
  posts              JurisPost[]

  @@unique([fonte, docIdExterno])
  @@index([tribunal])
  @@index([dataJulgamento])
  @@index([status])
  @@index([conteudoHash])
}

model JurisTab {
  id         String   @id @default(cuid())
  documentId String
  label      String
  url        String?

  document JurisDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model JurisAnexo {
  id         String   @id @default(cuid())
  documentId String
  titulo     String?
  url        String
  tipo       String?

  document JurisDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model JurisReferenciaLei {
  id         String  @id @default(cuid())
  documentId String
  texto      String
  url        String?

  document JurisDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model JurisReferenciaJuris {
  id                String  @id @default(cuid())
  documentId        String
  docRelacionadoId  String?
  titulo            String?
  url               String?

  document     JurisDocument  @relation("JurisRefFrom", fields: [documentId], references: [id], onDelete: Cascade)
  relacionado  JurisDocument? @relation("JurisRefTo", fields: [docRelacionadoId], references: [id], onDelete: SetNull)

  @@index([documentId])
}

model JurisPublicacaoDiario {
  id         String    @id @default(cuid())
  documentId String
  diario     String?
  data       DateTime? @db.Date
  pagina     String?

  document JurisDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model JurisTribunal {
  id     String  @id @default(cuid())
  sigla  String  @unique
  nome   String
  grau   String?
  regiao String?

  @@index([sigla])
}

model JurisAssunto {
  id       String  @id @default(cuid())
  nome     String
  parentId String?

  parent   JurisAssunto?  @relation("JurisAssuntoTree", fields: [parentId], references: [id], onDelete: SetNull)
  children JurisAssunto[] @relation("JurisAssuntoTree")

  @@index([parentId])
}

model JurisPost {
  id            String   @id @default(cuid())
  publicationId String   @unique
  documentId    String
  titulo        String?
  isArquivado   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  publication RedeTestePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  document    JurisDocument         @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
}

model JurisIngestJob {
  id         String    @id @default(cuid())
  fonte      JurisFonte
  status     String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  params     Json?
  result     Json?
  error      String?   @db.Text
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([fonte])
}
