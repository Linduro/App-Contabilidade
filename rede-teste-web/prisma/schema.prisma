// ============================================================
// CRM, CATÁLOGO DE TAREFAS E PIPELINE (paridade ADVBOX)
// ============================================================

enum ProcessPhase {
  TODAS
  MARKETING
  NEGOCIACAO
  CONSULTORIA
  ADMINISTRATIVO
  JUDICIAL
  RECURSAL
  EXECUCAO_COBRANCA
  RH_FINANCEIRO
  ARQUIVAMENTO
}

enum TaskComplexity {
  SIMPLES
  MEDIA
  MEDIA_ALTA
  ALTA
  ALTISSIMA
}

enum TaskAvgTime {
  MIN_8
  MIN_15
  MIN_30
  HORA_1
  HORAS_2_MAIS
}

// Catálogo de tarefas do escritório → pontuação derivada de complexidade × tempo médio
model TaskType {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  phase        ProcessPhase   @default(TODAS)
  complexity   TaskComplexity @default(MEDIA)
  avgTime      TaskAvgTime    @default(MIN_30)
  points       Int            @default(0)
  manualPoints Boolean        @default(false)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([phase])
}

model ActionGroup {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  responsibleUserId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionTypes ActionType[]

  @@index([tenantId])
}

model ActionType {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  actionGroupId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionGroup ActionGroup? @relation(fields: [actionGroupId], references: [id], onDelete: SetNull)
  crmCards    CrmCard[]

  @@index([tenantId])
  @@index([actionGroupId])
}

// Etapas customizáveis (subdivisões das fases) → colunas do CRM
model Stage {
  id             String       @id @default(cuid())
  tenantId       String
  name           String
  classification String?
  phase          ProcessPhase @default(TODAS)
  position       Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crmCards CrmCard[]

  @@index([tenantId])
  @@index([position])
}

model CrmCard {
  id                String    @id @default(cuid())
  tenantId          String
  stageId           String
  title             String?
  clientId          String?
  caseId            String?
  responsibleUserId String?
  actionTypeId      String?
  value             Decimal?  @db.Decimal(15, 2)
  position          Int       @default(0)
  stagnatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage      Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  actionType ActionType? @relation(fields: [actionTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([stageId, position])
  @@index([deletedAt])
}

