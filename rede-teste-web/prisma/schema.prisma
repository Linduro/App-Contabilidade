// Requerimentos/tarefas do INSS (portal atendimento.inss.gov.br via extensão)
// Sincronizados no navegador autenticado; upsert por protocolo.
model InssRequerimento {
  id                    String    @id @default(cuid())
  tenantId              String
  protocolo             String
  status                String    @default("PENDENTE") // PENDENTE | CANCELADA | CONCLUIDA | CUMPRIMENTO_DE_EXIGENCIA
  cpfRequerente         String    @default("") // string p/ preservar zeros à esquerda
  nomeRequerente        String    @default("")
  nomeServico           String    @default("")
  siglaServico          String    @default("")
  nomeUnidade           String    @default("")
  dataCriacao           DateTime?
  dataUltimaAtualizacao DateTime?
  teorExigencia         String?   @db.Text // teor da exigência (capturado em "Detalhar tarefa")
  prazoExigencia        DateTime? // prazo p/ cumprir a exigência, quando disponível
  readAt                DateTime? // marcado como lido (null = nova/não lida)
  raw                   Json?
  detalhe               Json?     // payload bruto do "Detalhar tarefa"
  syncedByUserId        String?
  lastSyncedAt          DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventos InssStatusEvent[]

  @@unique([tenantId, protocolo])
  @@index([tenantId])
  @@index([tenantId, status])
}

model InssStatusEvent {
  id             String   @id @default(cuid())
  tenantId       String
  requerimentoId String
  protocolo      String
  statusAnterior String? // null = primeiro registro
  statusNovo     String
  createdAt      DateTime @default(now())

  requerimento InssRequerimento @relation(fields: [requerimentoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requerimentoId])
}

enum StickyNoteVisibility {
  PRIVATE // só o autor
  TENANT // todos do escritório
  USER // um usuário específico (targetUserId)
}

// Notas adesivas (observações pessoais) com visibilidade configurável.
model StickyNote {
  id           String               @id @default(cuid())
  tenantId     String
  authorId     String
  authorName   String               @default("")
  body         String               @db.Text
  color        String               @default("amber") // amber | sky | emerald | rose | violet
  visibility   StickyNoteVisibility @default(PRIVATE)
  targetUserId String? // quando visibility = USER
  pinned       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  layouts      StickyNoteLayout[]

  @@index([tenantId])
  @@index([tenantId, authorId])
  @@index([tenantId, targetUserId])
}

/** Posição e estado recolhido da nota — por usuário (cada um vê onde deixou). */
model StickyNoteLayout {
  id        String   @id @default(cuid())
  tenantId  String
  noteId    String
  userId    String
  posX      Float    @default(80)
  posY      Float    @default(100)
  collapsed Boolean  @default(false)
  zIndex    Int      @default(1)
  updatedAt DateTime @updatedAt
  note      StickyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([tenantId, userId])
}

// Certificado A1 + fila de sync INSS Digital (worker Playwright — sem Chrome do usuário)
model LawyerCertificate {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  certId      String    @unique
  /** "A1" (arquivo .pfx no servidor) ou "A3" (token físico — sem chave no servidor). */
  certType    String    @default("A1")
  /** Número de série do token A3 (apenas referência; nada sigiloso). */
  serial      String?
  /** A1 apenas: caminho do .pfx no vault. Nulo para A3. */
  pfxPath     String?
  /** A1 apenas: senha do .pfx cifrada (AES-256-GCM). Nulo para A3. */
  passwordEnc String?
  subjectCn   String?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revokedAt   DateTime?

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs   InssDigitalSyncJob[]

  @@index([tenantId, userId])
}

model InssDigitalSyncJob {
  id            String    @id @default(cuid())
  tenantId      String
  certificateId String
  status        String    @default("PENDING")
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?   @db.Text
  imported      Int       @default(0)
  createdAt     DateTime  @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate LawyerCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([certificateId])
}

