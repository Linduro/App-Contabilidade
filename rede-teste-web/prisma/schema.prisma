// Laudos médicos — aba paralela à gestão de contratos (escritório [removido])
model MedicalReportRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  ano                 Int       @default(2026)
  contractRecordId    String?   // vínculo opcional ao contrato de origem
  cliente             String
  mes                 String    @default("")
