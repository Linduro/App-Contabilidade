/// Controle operacional (planilha judicial / administrativo — [removido]).
enum OperationalChannel {
  JUDICIAL
  ADMINISTRATIVO
}

model OperationalEntry {
  id                  String             @id @default(cuid())
  tenantId            String
  channel             OperationalChannel
  position            Int                @default(0)
  processRef          String             @default("")
  clientLabel         String
  lastMovement        String             @default("") @db.Text
  providence          String             @default("") @db.Text
  providenceResponse  String             @default("") @db.Text
  responsavel         String             @default("")
  status              String             @default("")
