  /** Desistência após assinatura — débito contabilizado no mês de dataDesistencia. */
  desistiu        String    @default("NÃO") // SIM | NÃO
  dataDesistencia DateTime?
  dataAssinatura  DateTime?
  dataEntrada     DateTime?
  obs             String    @default("")
  link            String    @default("")
  // Dados opcionais para importação no LinkLei
  linkleiCpf            String    @default("")
  linkleiRg             String    @default("")
  linkleiOrgaoExpeditor String    @default("")
  linkleiTelefone1      String    @default("")
  linkleiTelefone2      String    @default("")
  linkleiEmail          String    @default("")
  linkleiDataNascimento DateTime?
  linkleiNomeMae        String    @default("")
  linkleiNomePai        String    @default("")
  linkleiProfissao      String    @default("")
  linkleiEstadoCivil    String    @default("")
  linkleiNaturalidade   String    @default("")
  linkleiNacionalidade  String    @default("")
  linkleiCtps           String    @default("")
  linkleiPis            String    @default("")
  linkleiCep            String    @default("")
  linkleiLogradouro     String    @default("")
  linkleiNumero         String    @default("")
  linkleiComplemento    String    @default("")
  linkleiBairro         String    @default("")
  linkleiCidade         String    @default("")
  linkleiUf             String    @default("")
  linkleiEnviado        Boolean   @default(false)
