  valorCliente        Decimal   @default(0) @db.Decimal(12, 2) // "pagará o laudo?" — valor que o cliente paga
  valorEscritorio     Decimal   @default(0) @db.Decimal(12, 2) // participação do escritório (quanto o escritório paga)
  dataSolicitacao     DateTime?
  dataEntrega         DateTime?
  status              String    @default("PENDENTE") // PENDENTE | SOLICITADO | EM_ANALISE | ENTREGUE
