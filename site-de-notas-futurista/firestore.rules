rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminEmail(email) {
      return email != null && (
        email.lower() == 'cartoonhq@gmail.com'
        || email.lower() == 'gabrieldouran@gmail.com'
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isAdminEmail(request.auth.token.email)
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isAdminEmail(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email)
        )
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /progression/{docId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    match /notificationQueue/{notificationId} {
      allow create: if request.auth != null && request.resource.data.status == 'pending' && (
        request.resource.data.userId == request.auth.uid
        || (isAdmin() && request.resource.data.source == 'admin-custom')
      );
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /notes/{noteId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /messages/{messageId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /platformAds/{adId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /licitacoesConfig/{docId} {
      allow read, write: if isAdmin();
    }

    match /licitacoesEspecialidades/{docId} {
      allow read, write: if isAdmin();
    }

    match /licitacoes/{docId} {
      allow read, write: if isAdmin();
    }

    match /licitacoesMatches/{docId} {
      allow read, write: if isAdmin();
    }

    match /leads/{docId} {
      allow read, write: if isAdmin();
    }

    match /execucoesRurais/{docId} {
      allow read, write: if isAdmin();
    }

    match /execucoesAltoValor/{docId} {
      allow read, write: if isAdmin();
    }

    match /userSettings/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;

      match /filters/{moduleId} {
        allow read, write: if isAdmin() && request.auth.uid == userId;
      }
    }

    match /systemConfig/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
