# AFS Market Intelligence — variáveis de ambiente
PORT=5001
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# DuckDB (primário) ou sqlite (fallback)
DB_ENGINE=duckdb
DB_PATH=data/afs_market.duckdb

# Receita Federal — dados abertos
RF_DATA_URL=https://dados.gov.br/dados/conjuntos-dados/cadastro-nacional-da-pessoa-juridica-cnpj
RF_DATA_DIR=data/rf/raw

# Scraping — intervalos em segundos
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5

# SMTP validation
SMTP_TIMEOUT=10
SMTP_HELO_DOMAIN=afs.local

# LinkedIn (manual confirmation mode — sem automação de mensagens)
LINKEDIN_SEARCH_ENABLED=true

# Export
EXPORT_DIR=data/exports
