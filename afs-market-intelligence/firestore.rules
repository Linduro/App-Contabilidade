// Regras canônicas: ../site-de-notas-futurista/firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isAdminEmail(email) {
      return email != null && (
        email.lower() == 'cartoonhq@gmail.com'
        || email.lower() == 'gabrieldouran@gmail.com'
      );
    }
    function isAdmin() {
      return isAuth() && isAdminEmail(request.auth.token.email);
    }
    function isAfsMarketAdmin() {
      return isAdmin();
    }
    function isMarketLead() {
      return resource.data.keys().hasAny(['cnpj_basico', 'perfil_icp', 'regime_tributario']);
    }
    function isMarketLeadCreate() {
      return request.resource.data.keys().hasAny(['cnpj_basico', 'perfil_icp']);
    }
    match /leads/{leadId} {
      allow read: if isAdmin() || (isAuth() && isMarketLead());
      allow create, update: if isAdmin() || (isAuth() && (isMarketLead() || isMarketLeadCreate()));
      allow delete: if isAfsMarketAdmin();
    }
    match /historico_contato/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if isAfsMarketAdmin();
    }
    match /parceiros/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if isAfsMarketAdmin();
    }
    match /configuracoes/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if isAfsMarketAdmin();
    }
  }
}
