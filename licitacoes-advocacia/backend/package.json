{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test:licitita": "node scripts/test-licitita-scraper.js",
    "test:licitita:fixture": "node scripts/test-licitita-scraper.js --fixture",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:pipeline": "npm run build && node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/pipeline.test.js",
    "setup:python": "pip install -r requirements.txt && python -m spacy download pt_core_news_sm",
    "test:classifier": "python src/classifier/classifier.py",
    "job:collect": "tsx scripts/run-collect-and-match.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "node-cron": "^3.0.3",
    "resend": "^4.5.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
