# =============================================================================
# Raiz — variáveis compartilhadas (copie para .env na raiz se necessário)
# =============================================================================

# Supabase (PostgreSQL)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Backend (Railway)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Classificador jurídico (Python + spaCy)
PYTHON_PATH=python
CLASSIFIER_MIN_CONFIDENCE=0.3
CLASSIFIER_TIMEOUT_MS=30000
# Opcional: URL HTTP do classificador em container separado (ex.: http://classifier:8000/classify)
# CLASSIFIER_URL=

# Scheduler (node-cron — job collectAndMatch a cada 6h)
CRON_COLLECT_SCHEDULE=0 */6 * * *

# E-mail (Resend — recomendado para Vercel/Railway)
RESEND_API_KEY=re_sua_chave_aqui
EMAIL_FROM=Licitacoes Advocacia <alertas@seudominio.com>

# Frontend (Vercel) — prefixo VITE_ expõe ao client
VITE_API_URL=http://localhost:3001/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
